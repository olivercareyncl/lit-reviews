# Python cache / virtual envs
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.env

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# OS junk
.DS_Store
Thumbs.db

# VSCode / IDEs
.vscode/
.idea/

# Data directories (never commit raw/interim/processed)
data/raw/*
data/interim/*
data/processed/*
data/external/*

# But keep folder structure (via .gitkeep)
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!data/external/.gitkeep

# Outputs
reports/*
figures/*
!reports/.gitkeep
!figures/.gitkeep

# Logs / temp
*.log
*.tmp
*.bak
